{
  "manifest_version": 3,
  "name": "PDFVault — Offline PDF Merge & Split",
  "short_name": "PDFVault",
  "version": "1.0.0",
  "description": "100% offline PDF merger, splitter, rotator, watermark & Image-to-PDF tool. Process sensitive contracts & IDs locally with zero cloud uploads.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://api.gumroad.com/*"
  ],
  "action": {
    "default_title": "Open PDFVault Offline Workbench",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
