{
  "manifest_version": 3,
  "name": "PDFVault — Offline PDF Merge & Split",
  "short_name": "PDFVault",
  "version": "1.0.0",
  "description": "100% offline PDF merger, splitter, rotator, watermark & Image-to-PDF tool. Process sensitive contracts & IDs locally with zero cloud uploads.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://api.gumroad.com/*"
  ],
  "action": {
    "default_title": "Open PDFVault Offline Workbench",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "scripts": [
      "src/background.js"
    ]
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "pdfvault@nanemones.github.io",
      "strict_min_version": "121.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
